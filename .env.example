# ============================================================
# Instagram Agent — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus dados reais
# NUNCA commite o arquivo .env em repositórios públicos
# ============================================================

# Instagram Graph API
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Nome de usuário do Instagram (sem @)
INSTAGRAM_USERNAME=your_username

# Caminho absoluto da pasta do projeto
PROJECT_ROOT=/Users/vcb/Documents/Claude/Projects/SFN/Instagram Agent
